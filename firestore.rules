rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        userDoc().data.disabled != true &&
        userDoc().data.role in ['owner', 'manager', 'billing'];
    }

    function isOwner() {
      return isStaff() && userDoc().data.role == 'owner';
    }

    function isManagerOrOwner() {
      return isStaff() && userDoc().data.role in ['owner', 'manager'];
    }

    function isBilling() {
      return isStaff() && userDoc().data.role == 'billing';
    }

    function isCashoutWindowOpen() {
      let istTime = request.time + duration.value(19800, 's');
      let minuteOfDay = istTime.hours() * 60 + istTime.minutes();
      return minuteOfDay >= 1435 || minuteOfDay <= 20;
    }

    function hasPurchasingCapability(capability) {
      return isOwner() || (
        isStaff() &&
        (
          capability in ['vendor.manage', 'purchase.create', 'settlement.create', 'settlement.correct', 'return.create', 'vendorLedger.view'] ||
          (
            userDoc().data.keys().hasAny(['purchasingCapabilities']) &&
            userDoc().data.purchasingCapabilities.keys().hasAny([capability]) &&
            userDoc().data.purchasingCapabilities[capability] == true
          )
        )
      );
    }

    function isVendorLedgerV2Inactive() {
      return !exists(/databases/$(database)/documents/appMetadata/vendorLedgerV2Config) ||
        get(/databases/$(database)/documents/appMetadata/vendorLedgerV2Config).data.enabled != true;
    }

    function isVendorLedgerV2Enabled() {
      return get(/databases/$(database)/documents/appMetadata/vendorLedgerV2Config).data.enabled == true;
    }

    function isVendorLedgerV2EnabledAfter() {
      return getAfter(/databases/$(database)/documents/appMetadata/vendorLedgerV2Config).data.enabled == true;
    }

    function isPositivePaise(value) {
      return value is int && value > 0;
    }

    function isPayrollRole(role) {
      return role in ['manager', 'billing'];
    }

    function validPayrollMonthKey(value) {
      return value is string && value.size() == 7;
    }

    function validPayrollActor(data, uidField, timestampField) {
      return data[uidField] == request.auth.uid && data[timestampField] == request.time;
    }

    function validPayrollEventLink(eventId, eventType) {
      return eventId is string &&
        getAfter(/databases/$(database)/documents/payrollEvents/$(eventId)).data.id == eventId &&
        getAfter(/databases/$(database)/documents/payrollEvents/$(eventId)).data.type == eventType &&
        getAfter(/databases/$(database)/documents/payrollEvents/$(eventId)).data.actorUid == request.auth.uid;
    }

    function validPayrollCalculation(data) {
      return validPayrollMonthKey(data.payrollMonth) &&
        isPositivePaise(data.monthlySalaryPaise) &&
        data.requiredDailyMinutes is int && data.requiredDailyMinutes > 0 && data.requiredDailyMinutes <= 1440 &&
        data.paidWeeklyOffDays is int && data.paidWeeklyOffDays >= 0 && data.paidWeeklyOffDays <= 31 &&
        data.workedMinutes is int && data.workedMinutes >= 0 &&
        data.paidLeaveMinutes is int && data.paidLeaveMinutes >= 0 &&
        data.earnings is list && data.deductions is list &&
        data.calendarDays is int && data.calendarDays >= 28 && data.calendarDays <= 31 &&
        data.expectedMinutes is int && data.expectedMinutes > 0 &&
        data.weeklyOffMinutes is int && data.weeklyOffMinutes >= 0 &&
        data.payableMinutes is int && data.payableMinutes >= 0 &&
        data.basePayPaise is int && data.basePayPaise >= 0 &&
        data.earningsPaise is int && data.earningsPaise >= 0 &&
        data.deductionsPaise is int && data.deductionsPaise >= 0 &&
        data.netPayPaise is int && data.netPayPaise >= 0;
    }

    function validSalaryRevisionLink(data, documentId) {
      return data.currentRevisionId is string &&
        getAfter(/databases/$(database)/documents/salarySlipRevisions/$(data.currentRevisionId)).data.id == data.currentRevisionId &&
        getAfter(/databases/$(database)/documents/salarySlipRevisions/$(data.currentRevisionId)).data.slipId == documentId &&
        getAfter(/databases/$(database)/documents/salarySlipRevisions/$(data.currentRevisionId)).data.revision == data.currentRevision &&
        getAfter(/databases/$(database)/documents/salarySlipRevisions/$(data.currentRevisionId)).data.employeeUserId == data.employeeUserId;
    }

    function validV2Identity(data, documentId) {
      return hasDocumentId(data, documentId) &&
        data.revision is int &&
        data.revision >= 1 &&
        data.createdAt is string &&
        data.createdByUserId == request.auth.uid;
    }

    function immutableV2Identity() {
      return request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.revision == resource.data.revision + 1;
    }

    function validVendorV2(data, documentId) {
      return validV2Identity(data, documentId) &&
        data.canonicalName is string &&
        data.canonicalName.size() > 0 &&
        data.openingBalancePaise is int &&
        data.openingBalancePaise >= 0 &&
        (
          (data.openingBalancePaise == 0 && !data.keys().hasAny(['openingLedgerEntryId'])) ||
          (
            data.openingBalancePaise > 0 &&
            data.openingLedgerEntryId is string &&
            getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.openingLedgerEntryId)).data.eventType == 'opening-balance' &&
            getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.openingLedgerEntryId)).data.vendorId == documentId &&
            getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.openingLedgerEntryId)).data.signedAmountPaise == data.openingBalancePaise &&
            getAfter(/databases/$(database)/documents/vendorAccountStatesV2/$(documentId)).data.outstandingPaise == data.openingBalancePaise
          )
        );
    }

    function validPurchaseV2(data, documentId) {
      return validV2Identity(data, documentId) &&
        data.vendorId is string &&
        data.invoiceNumber is string &&
        data.normalizedInvoiceNumber is string &&
        data.normalizedInvoiceNumber.size() > 0 &&
        data.invoiceDate is string &&
        isPositivePaise(data.invoiceTotalPaise) &&
        data.invoiceReservationId is string &&
        data.ledgerEntryId is string &&
        get(/databases/$(database)/documents/vendorsV2/$(data.vendorId)).data.active == true &&
        getAfter(/databases/$(database)/documents/invoiceReservationsV2/$(data.invoiceReservationId)).data.purchaseId == documentId &&
        getAfter(/databases/$(database)/documents/invoiceReservationsV2/$(data.invoiceReservationId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/invoiceReservationsV2/$(data.invoiceReservationId)).data.normalizedInvoiceNumber == data.normalizedInvoiceNumber &&
        getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.ledgerEntryId)).data.sourceRecordId == documentId &&
        getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.ledgerEntryId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.ledgerEntryId)).data.signedAmountPaise == data.invoiceTotalPaise &&
        getAfter(/databases/$(database)/documents/vendorAccountStatesV2/$(data.vendorId)).data.lastLedgerEntryId == data.ledgerEntryId &&
        getAfter(/databases/$(database)/documents/invoiceStatesV2/$(documentId)).data.openAmountPaise == data.invoiceTotalPaise;
    }

    function validInvoiceReservationV2(data, documentId) {
      return data.id == documentId &&
        data.vendorId is string &&
        data.normalizedInvoiceNumber is string &&
        data.normalizedInvoiceNumber.size() > 0 &&
        data.purchaseId is string &&
        data.createdAt is string &&
        data.createdByUserId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/purchasesV2/$(data.purchaseId)).data.invoiceReservationId == documentId &&
        getAfter(/databases/$(database)/documents/purchasesV2/$(data.purchaseId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/purchasesV2/$(data.purchaseId)).data.normalizedInvoiceNumber == data.normalizedInvoiceNumber;
    }

    function validSettlementV2(data, documentId) {
      return validV2Identity(data, documentId) &&
        data.vendorId is string &&
        data.date is string &&
        isPositivePaise(data.amountPaise) &&
        data.mode in ['cash', 'upi', 'card', 'bank-transfer'] &&
        data.ledgerEntryId is string &&
        getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.ledgerEntryId)).data.sourceRecordId == documentId &&
        getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.ledgerEntryId)).data.signedAmountPaise == -data.amountPaise &&
        getAfter(/databases/$(database)/documents/vendorAccountStatesV2/$(data.vendorId)).data.lastLedgerEntryId == data.ledgerEntryId &&
        getAfter(/databases/$(database)/documents/vendorSettlementStatesV2/$(documentId)).data.amountPaise == data.amountPaise &&
        (
          (!data.keys().hasAny(['invoiceId', 'allocationId'])) ||
          (
            data.invoiceId is string &&
            data.allocationId is string &&
            getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.allocationId)).data.invoiceId == data.invoiceId &&
            getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.allocationId)).data.sourceRecordId == documentId &&
            getAfter(/databases/$(database)/documents/invoiceStatesV2/$(data.invoiceId)).data.lastAllocationId == data.allocationId
          )
        );
    }

    function validReturnV2(data, documentId) {
      return validV2Identity(data, documentId) &&
        data.vendorId is string &&
        data.date is string &&
        data.description is string && data.description.size() > 0 &&
        data.quantity is number && data.quantity > 0 &&
        data.unit is string && data.unit.size() > 0 &&
        data.reason is string && data.reason.size() > 0 &&
        isPositivePaise(data.valuePaise) &&
        data.outcome == 'pending' &&
        get(/databases/$(database)/documents/vendorsV2/$(data.vendorId)).data.active == true &&
        (
          !data.keys().hasAny(['sourcePurchaseId']) ||
          get(/databases/$(database)/documents/purchasesV2/$(data.sourcePurchaseId)).data.vendorId == data.vendorId
        );
    }

    function validChequeV2(data, documentId) {
      return validV2Identity(data, documentId) &&
        data.chequeNumber == documentId &&
        data.chequeNumberValue is int &&
        data.chequeNumberValue >= 1120 && data.chequeNumberValue <= 1199 &&
        data.purpose == 'vendor-payment' &&
        data.sourceRecordId == documentId &&
        data.vendorId is string &&
        get(/databases/$(database)/documents/vendorsV2/$(data.vendorId)).data.active == true &&
        get(/databases/$(database)/documents/vendorAccountStatesV2/$(data.vendorId)).data.outstandingPaise >= data.amountPaise &&
        data.chequeBookId is string &&
        get(/databases/$(database)/documents/chequeBooksV2/$(data.chequeBookId)).data.active == true &&
        data.chequeNumberValue >= get(/databases/$(database)/documents/chequeBooksV2/$(data.chequeBookId)).data.startNumber &&
        data.chequeNumberValue <= get(/databases/$(database)/documents/chequeBooksV2/$(data.chequeBookId)).data.endNumber &&
        data.date is string &&
        isPositivePaise(data.amountPaise) &&
        data.status == 'draft' &&
        data.origin == 'v2' &&
        data.trackingOnly == false;
    }

    function canUpdateChequeStatus() {
      return immutableV2Identity() &&
        request.resource.data.updatedByUserId == request.auth.uid &&
        (
          (
            resource.data.status == 'draft' && request.resource.data.status == 'issued' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'revision', 'pendingLedgerEntryId', 'updatedAt', 'updatedByUserId'
            ]) &&
            getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(request.resource.data.pendingLedgerEntryId)).data.eventType == 'pending-cheque' &&
            hasPurchasingCapability('cheque.issue')
          ) ||
          (
            resource.data.status == 'issued' && request.resource.data.status == 'presented' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revision', 'updatedAt', 'updatedByUserId']) &&
            hasPurchasingCapability('cheque.present')
          ) ||
          (
            resource.data.status == 'presented' && request.resource.data.status == 'debited' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'revision', 'debitLedgerEntryId', 'updatedAt', 'updatedByUserId'
            ]) &&
            getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(request.resource.data.debitLedgerEntryId)).data.eventType == 'cheque-debit' &&
            getAfter(/databases/$(database)/documents/vendorAccountStatesV2/$(resource.data.vendorId)).data.lastLedgerEntryId == request.resource.data.debitLedgerEntryId &&
            hasPurchasingCapability('cheque.debit')
          ) ||
          (
            resource.data.status in ['issued', 'presented'] && request.resource.data.status in ['cancelled', 'bounced'] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revision', 'updatedAt', 'updatedByUserId']) &&
            hasPurchasingCapability('cheque.cancel')
          )
        );
    }

    function canResolveVendorReturn() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'outcome', 'outcomeReason', 'creditedValuePaise', 'ledgerEntryId', 'replacementReceivedAt',
          'reviewedAt', 'reviewedByUserId', 'reviewedBy', 'revision', 'updatedAt', 'updatedByUserId'
        ]) &&
        isOwner() &&
        resource.data.outcome == 'pending' &&
        immutableV2Identity() &&
        request.resource.data.updatedByUserId == request.auth.uid &&
        request.resource.data.reviewedByUserId == request.auth.uid &&
        request.resource.data.reviewedAt is string &&
        request.resource.data.reviewedBy is string &&
        request.resource.data.outcomeReason is string &&
        request.resource.data.outcomeReason.size() > 0 &&
        request.resource.data.outcome in ['vendor-credit', 'replacement', 'rejected'] &&
        (
          (
            request.resource.data.outcome == 'vendor-credit' &&
            isPositivePaise(request.resource.data.creditedValuePaise) &&
            request.resource.data.creditedValuePaise <= resource.data.valuePaise &&
            request.resource.data.ledgerEntryId is string &&
            getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(request.resource.data.ledgerEntryId)).data.sourceRecordId == resource.data.id &&
            getAfter(/databases/$(database)/documents/vendorAccountStatesV2/$(resource.data.vendorId)).data.lastLedgerEntryId == request.resource.data.ledgerEntryId
          ) ||
          (
            request.resource.data.outcome == 'replacement' &&
            request.resource.data.replacementReceivedAt is string &&
            !request.resource.data.keys().hasAny(['creditedValuePaise', 'ledgerEntryId'])
          ) ||
          (
            request.resource.data.outcome == 'rejected' &&
            !request.resource.data.keys().hasAny(['creditedValuePaise', 'ledgerEntryId', 'replacementReceivedAt'])
          )
        );
    }

    function canCreateLedgerEntry(data) {
      return isOwner() ||
        (data.eventType == 'purchase' && hasPurchasingCapability('purchase.create')) ||
        (data.eventType == 'settlement' && hasPurchasingCapability('settlement.create')) ||
        (data.eventType == 'vendor-credit' && hasPurchasingCapability('return.resolve')) ||
        (data.eventType == 'pending-cheque' && hasPurchasingCapability('cheque.issue')) ||
        (data.eventType == 'cheque-debit' && hasPurchasingCapability('cheque.debit'));
    }

    function validPurchaseLedgerEntry(data, documentId) {
      return data.eventType != 'purchase' || (
        data.posting == 'financial' &&
        data.sourceType == 'purchase' &&
        data.sourceRevision == 1 &&
        data.signedAmountPaise > 0 &&
        getAfter(/databases/$(database)/documents/purchasesV2/$(data.sourceRecordId)).data.ledgerEntryId == documentId &&
        getAfter(/databases/$(database)/documents/purchasesV2/$(data.sourceRecordId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/purchasesV2/$(data.sourceRecordId)).data.invoiceTotalPaise == data.signedAmountPaise
      );
    }

    function validOpeningLedgerEntry(data, documentId) {
      return data.eventType != 'opening-balance' || (
        isOwner() &&
        data.posting == 'financial' &&
        data.sourceType == 'vendor' &&
        data.sourceRevision == 1 &&
        data.signedAmountPaise > 0 &&
        data.reason is string && data.reason.size() > 0 &&
        getAfter(/databases/$(database)/documents/vendorsV2/$(data.sourceRecordId)).data.openingLedgerEntryId == documentId &&
        getAfter(/databases/$(database)/documents/vendorsV2/$(data.sourceRecordId)).data.openingBalancePaise == data.signedAmountPaise
      );
    }

    function validSettlementLedgerEntry(data, documentId) {
      return data.eventType != 'settlement' || (
        data.posting == 'financial' &&
        data.sourceType == 'settlement' &&
        data.sourceRevision == 1 &&
        data.signedAmountPaise < 0 &&
        getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(data.sourceRecordId)).data.ledgerEntryId == documentId &&
        getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(data.sourceRecordId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(data.sourceRecordId)).data.amountPaise == -data.signedAmountPaise
      );
    }

    function validCorrectionLedgerEntry(data, documentId) {
      return data.eventType != 'reversal' || (
        isOwner() &&
        data.posting == 'financial' &&
        data.sourceType == 'ledger-entry' &&
        data.sourceRevision == 1 &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.status == 'approved' &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.vendorId == data.vendorId &&
        data.signedAmountPaise ==
          getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.before.amountPaise -
          getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.proposed.amountPaise
      );
    }

    function validReturnLedgerEntry(data, documentId) {
      return data.eventType != 'vendor-credit' || (
        isOwner() &&
        data.posting == 'financial' &&
        data.sourceType == 'return' &&
        data.signedAmountPaise < 0 &&
        getAfter(/databases/$(database)/documents/vendorReturnsV2/$(data.sourceRecordId)).data.outcome == 'vendor-credit' &&
        getAfter(/databases/$(database)/documents/vendorReturnsV2/$(data.sourceRecordId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/vendorReturnsV2/$(data.sourceRecordId)).data.revision == data.sourceRevision &&
        getAfter(/databases/$(database)/documents/vendorReturnsV2/$(data.sourceRecordId)).data.ledgerEntryId == documentId &&
        getAfter(/databases/$(database)/documents/vendorReturnsV2/$(data.sourceRecordId)).data.creditedValuePaise == -data.signedAmountPaise
      );
    }

    function validChequeLedgerEntry(data, documentId) {
      return !(data.eventType in ['pending-cheque', 'cheque-debit']) || (
        data.sourceType == 'cheque' &&
        data.signedAmountPaise < 0 &&
        getAfter(/databases/$(database)/documents/chequesV2/$(data.sourceRecordId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/chequesV2/$(data.sourceRecordId)).data.amountPaise == -data.signedAmountPaise &&
        getAfter(/databases/$(database)/documents/chequesV2/$(data.sourceRecordId)).data.revision == data.sourceRevision &&
        (
          (
            data.eventType == 'pending-cheque' && data.posting == 'informational' &&
            getAfter(/databases/$(database)/documents/chequesV2/$(data.sourceRecordId)).data.status == 'issued' &&
            getAfter(/databases/$(database)/documents/chequesV2/$(data.sourceRecordId)).data.pendingLedgerEntryId == documentId
          ) ||
          (
            data.eventType == 'cheque-debit' && data.posting == 'financial' &&
            getAfter(/databases/$(database)/documents/chequesV2/$(data.sourceRecordId)).data.status == 'debited' &&
            getAfter(/databases/$(database)/documents/chequesV2/$(data.sourceRecordId)).data.debitLedgerEntryId == documentId
          )
        )
      );
    }

    function validVendorAccountStateCreate(data, documentId) {
      return data.id == documentId &&
        data.vendorId == documentId &&
        data.outstandingPaise is int &&
        data.outstandingPaise >= 0 &&
        data.revision == 1 &&
        data.lastLedgerEntryId is string &&
        data.updatedByUserId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.lastLedgerEntryId)).data.vendorId == documentId &&
        data.outstandingPaise == getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.lastLedgerEntryId)).data.signedAmountPaise;
    }

    function validVendorAccountStateUpdate(data, documentId) {
      return data.id == documentId &&
        data.vendorId == resource.data.vendorId &&
        data.revision == resource.data.revision + 1 &&
        data.lastLedgerEntryId is string &&
        data.updatedByUserId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.lastLedgerEntryId)).data.vendorId == documentId &&
        data.outstandingPaise == resource.data.outstandingPaise +
          getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(data.lastLedgerEntryId)).data.signedAmountPaise &&
        data.outstandingPaise >= 0;
    }

    function validInvoiceStateCreate(data, documentId) {
      return data.id == documentId &&
        data.invoiceId == documentId &&
        data.revision == 1 &&
        data.openAmountPaise == getAfter(/databases/$(database)/documents/purchasesV2/$(documentId)).data.invoiceTotalPaise &&
        data.reservedAmountPaise == 0 &&
        data.vendorId == getAfter(/databases/$(database)/documents/purchasesV2/$(documentId)).data.vendorId &&
        data.updatedByUserId == request.auth.uid;
    }

    function validInvoiceStateUpdate(data, documentId) {
      return data.id == documentId &&
        data.invoiceId == resource.data.invoiceId &&
        data.vendorId == resource.data.vendorId &&
        data.revision == resource.data.revision + 1 &&
        data.lastAllocationId is string &&
        data.updatedByUserId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.lastAllocationId)).data.invoiceId == documentId &&
        (
          (
            getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.lastAllocationId)).data.state == 'posted' &&
            data.openAmountPaise == resource.data.openAmountPaise -
              getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.lastAllocationId)).data.amountPaise
          ) ||
          (
            getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.lastAllocationId)).data.sourceType == 'settlement-correction' &&
            getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.lastAllocationId)).data.state == 'reversed' &&
            data.openAmountPaise == resource.data.openAmountPaise +
              getAfter(/databases/$(database)/documents/invoiceAllocationsV2/$(data.lastAllocationId)).data.amountPaise
          )
        ) &&
        data.openAmountPaise >= 0 &&
        data.reservedAmountPaise == resource.data.reservedAmountPaise;
    }

    function validSettlementAllocation(data, documentId) {
      return data.id == documentId &&
        data.sourceType == 'settlement' &&
        data.state == 'posted' &&
        data.revision == 1 &&
        data.createdByUserId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(data.sourceRecordId)).data.allocationId == documentId &&
        getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(data.sourceRecordId)).data.invoiceId == data.invoiceId &&
        getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(data.sourceRecordId)).data.amountPaise == data.amountPaise;
    }

    function validCorrectionAllocation(data, documentId) {
      return data.id == documentId &&
        isOwner() &&
        data.sourceType == 'settlement-correction' &&
        data.state in ['posted', 'reversed'] &&
        data.revision == 1 &&
        data.createdByUserId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.status == 'approved' &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.before.invoiceId == data.invoiceId &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.proposed.invoiceId == data.invoiceId &&
        (
          (
            data.state == 'reversed' &&
            getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.before.amountPaise >
              getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.proposed.amountPaise &&
            data.amountPaise ==
              getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.before.amountPaise -
              getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.proposed.amountPaise
          ) ||
          (
            data.state == 'posted' &&
            getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.proposed.amountPaise >
              getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.before.amountPaise &&
            data.amountPaise ==
              getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.proposed.amountPaise -
              getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.sourceRecordId)).data.before.amountPaise
          )
        );
    }

    function validSettlementStateCreate(data, documentId) {
      return data.id == documentId && data.settlementId == documentId && data.revision == 1 &&
        data.vendorId == getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(documentId)).data.vendorId &&
        data.amountPaise == getAfter(/databases/$(database)/documents/vendorSettlementsV2/$(documentId)).data.amountPaise &&
        data.updatedByUserId == request.auth.uid;
    }

    function validSettlementStateCorrection(data, documentId) {
      return isOwner() && data.id == documentId && data.settlementId == resource.data.settlementId &&
        data.vendorId == resource.data.vendorId && data.revision == resource.data.revision + 1 &&
        data.lastCorrectionId is string && data.updatedByUserId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.status == 'approved' &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.sourceRecordId == documentId &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.vendorId == data.vendorId &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.sourceRevision == resource.data.revision &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.proposed.amountPaise == data.amountPaise &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.proposed.date == data.date &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.proposed.mode == data.mode &&
        getAfter(/databases/$(database)/documents/vendorLedgerCorrectionRequestsV2/$(data.lastCorrectionId)).data.proposed.notes == data.notes;
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function hasDocumentId(data, documentId) {
      return !data.keys().hasAny(['id']) || data.id == documentId;
    }

    function validSales(data, documentId) {
      return hasDocumentId(data, documentId) &&
        data.storeId is string &&
        data.date is string &&
        isNonNegativeNumber(data.totalSales) &&
        isNonNegativeNumber(data.cashSales) &&
        isNonNegativeNumber(data.upiSales) &&
        isNonNegativeNumber(data.cardSales) &&
        isNonNegativeNumber(data.bankTransferSales) &&
        isNonNegativeNumber(data.creditSales) &&
        isNonNegativeNumber(data.returnsDiscounts) &&
        data.totalSales == data.cashSales + data.upiSales + data.cardSales + data.bankTransferSales + data.creditSales &&
        data.createdAt is string &&
        data.updatedAt is string;
    }

    function validPurchaseCreate(data, documentId) {
      return hasDocumentId(data, documentId) &&
        data.storeId is string &&
        data.date is string &&
        data.supplierName is string &&
        isNonNegativeNumber(data.purchaseAmount) &&
        isNonNegativeNumber(data.paidAmount) &&
        isNonNegativeNumber(data.unpaidAmount) &&
        data.paidAmount + data.unpaidAmount == data.purchaseAmount &&
        data.createdAt is string &&
        data.updatedAt is string;
    }

    function isVendorPaymentAllocation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidAmount', 'unpaidAmount', 'updatedAt']) &&
        request.resource.data.paidAmount >= resource.data.paidAmount &&
        request.resource.data.unpaidAmount <= resource.data.unpaidAmount &&
        request.resource.data.unpaidAmount >= 0 &&
        request.resource.data.paidAmount + request.resource.data.unpaidAmount == resource.data.purchaseAmount;
    }

    function isOpeningBalanceAllocation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openingOutstandingRemaining', 'updatedAt']) &&
        request.resource.data.openingOutstandingRemaining is number &&
        request.resource.data.openingOutstandingRemaining >= 0 &&
        request.resource.data.openingOutstandingRemaining <= resource.data.openingOutstandingRemaining;
    }

    function isVendorDirectoryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'ownerName',
        'contact',
        'address',
        'companiesProvided',
        'notes',
        'updatedAt'
      ]) && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validCashTransferCreate(data, documentId) {
      return hasDocumentId(data, documentId) &&
        data.date is string &&
        data.fromUserId is string &&
        data.toType in ['person', 'bank'] &&
        isNonNegativeNumber(data.amount) &&
        data.amount > 0 &&
        data.reason is string &&
        data.reason.size() > 0 &&
        data.createdBy is string &&
        data.createdAt is string &&
        (
          (data.toType == 'bank' && (!('bankDepositMethod' in data) || data.bankDepositMethod in ['bank', 'cdm'])) ||
          (data.toType == 'person' && data.toUserId is string && data.toUserId != data.fromUserId && !('bankDepositMethod' in data))
        );
    }

    match /users/{userId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isOwner();
      allow delete: if isOwner() && !exists(/databases/$(database)/documents/payrollProfiles/$(userId));
    }

    match /payrollSettings/{documentId} {
      allow read: if isOwner();
      allow create, update: if documentId == 'config' && isOwner() &&
        request.resource.data.issuer is map &&
        request.resource.data.issuer.name is string && request.resource.data.issuer.name.size() > 0 &&
        request.resource.data.defaultPaidWeeklyOffDays is int &&
        request.resource.data.defaultPaidWeeklyOffDays >= 0 && request.resource.data.defaultPaidWeeklyOffDays <= 31 &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt') &&
        validPayrollEventLink(request.resource.data.lastEventId, 'settings-updated');
      allow delete: if false;
    }

    match /payrollProfiles/{documentId} {
      allow read: if isOwner();
      allow create: if isOwner() &&
        request.resource.data.employeeUserId == documentId &&
        request.resource.data.enabled is bool &&
        request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt') &&
        validPayrollEventLink(request.resource.data.lastEventId, 'profile-updated') &&
        get(/databases/$(database)/documents/users/$(documentId)).data.role in ['manager', 'billing'];
      allow update: if isOwner() &&
        request.resource.data.employeeUserId == resource.data.employeeUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdByName == resource.data.createdByName &&
        request.resource.data.enabled is bool &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt') &&
        validPayrollEventLink(request.resource.data.lastEventId, 'profile-updated');
      allow delete: if false;
    }

    match /payrollTerms/{documentId} {
      allow read: if isOwner();
      allow create: if isOwner() &&
        request.resource.data.id == documentId &&
        request.resource.data.employeeUserId is string &&
        validPayrollMonthKey(request.resource.data.effectiveFromMonth) &&
        isPositivePaise(request.resource.data.monthlySalaryPaise) &&
        request.resource.data.requiredDailyMinutes is int &&
        request.resource.data.requiredDailyMinutes > 0 && request.resource.data.requiredDailyMinutes <= 1440 &&
        request.resource.data.revision is int && request.resource.data.revision >= 1 &&
        request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time &&
        validPayrollEventLink(request.resource.data.auditEventId, 'term-created') &&
        get(/databases/$(database)/documents/payrollProfiles/$(request.resource.data.employeeUserId)).data.enabled == true;
      allow update, delete: if false;
    }

    match /payrollMonths/{documentId} {
      allow read: if isOwner();
      allow create: if isOwner() &&
        request.resource.data.id == documentId && request.resource.data.payrollMonth == documentId &&
        validPayrollMonthKey(documentId) &&
        request.resource.data.paidWeeklyOffDays is int &&
        request.resource.data.paidWeeklyOffDays >= 0 && request.resource.data.paidWeeklyOffDays <= 31 &&
        request.resource.data.finalizedSlipCount == 0 &&
        request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt') &&
        validPayrollEventLink(request.resource.data.lastEventId, 'month-configured');
      allow update: if isOwner() &&
        request.resource.data.id == resource.data.id && request.resource.data.payrollMonth == resource.data.payrollMonth &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdByName == resource.data.createdByName &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt') &&
        (
          (
            resource.data.finalizedSlipCount == 0 && request.resource.data.finalizedSlipCount == 0 &&
            request.resource.data.paidWeeklyOffDays is int &&
            request.resource.data.paidWeeklyOffDays >= 0 && request.resource.data.paidWeeklyOffDays <= 31 &&
            validPayrollEventLink(request.resource.data.lastEventId, 'month-configured')
          ) ||
          (
            request.resource.data.finalizedSlipCount == resource.data.finalizedSlipCount + 1 &&
            request.resource.data.paidWeeklyOffDays == resource.data.paidWeeklyOffDays &&
            validPayrollEventLink(request.resource.data.lastEventId, 'slip-finalized')
          )
        );
      allow delete: if false;
    }

    match /payrollDrafts/{documentId} {
      allow read: if isOwner();
      allow create: if isOwner() &&
        request.resource.data.id == documentId &&
        request.resource.data.employeeUserId is string &&
        validPayrollMonthKey(request.resource.data.payrollMonth) &&
        isPayrollRole(request.resource.data.employeeRole) &&
        request.resource.data.termId is string &&
        request.resource.data.paidWeeklyOffDays is int && request.resource.data.paidWeeklyOffDays >= 0 &&
        request.resource.data.workedMinutes is int && request.resource.data.workedMinutes >= 0 &&
        request.resource.data.paidLeaveMinutes is int && request.resource.data.paidLeaveMinutes >= 0 &&
        request.resource.data.earnings is list && request.resource.data.deductions is list &&
        request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt');
      allow update: if isOwner() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.employeeUserId == resource.data.employeeUserId &&
        request.resource.data.payrollMonth == resource.data.payrollMonth &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdByName == resource.data.createdByName &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt');
      allow delete: if isOwner();
    }

    match /salarySlips/{documentId} {
      allow read: if isOwner() || (isStaff() && resource.data.employeeUserId == request.auth.uid);
      allow create: if isOwner() &&
        request.resource.data.id == documentId &&
        request.resource.data.employeeUserId is string &&
        isPayrollRole(request.resource.data.employeeRole) &&
        validPayrollMonthKey(request.resource.data.payrollMonth) &&
        request.resource.data.currentRevision == 1 &&
        validPayrollCalculation(request.resource.data.currentCalculation) &&
        request.resource.data.totalPaidPaise == 0 && request.resource.data.paymentState == 'unpaid' &&
        request.resource.data.outstandingPaise == request.resource.data.currentCalculation.netPayPaise &&
        request.resource.data.overpaidPaise == 0 &&
        request.resource.data.finalizedByUid == request.auth.uid && request.resource.data.finalizedAt == request.time &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt') &&
        validPayrollEventLink(request.resource.data.lastEventId, 'slip-finalized') &&
        validSalaryRevisionLink(request.resource.data, documentId);
      allow update: if isOwner() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.employeeUserId == resource.data.employeeUserId &&
        request.resource.data.employeeName == resource.data.employeeName &&
        request.resource.data.employeeRole == resource.data.employeeRole &&
        request.resource.data.payrollMonth == resource.data.payrollMonth &&
        request.resource.data.finalizedAt == resource.data.finalizedAt &&
        request.resource.data.finalizedByUid == resource.data.finalizedByUid &&
        request.resource.data.finalizedByName == resource.data.finalizedByName &&
        validPayrollActor(request.resource.data, 'updatedByUid', 'updatedAt') &&
        (
          (
            request.resource.data.currentRevision == resource.data.currentRevision + 1 &&
            request.resource.data.totalPaidPaise == resource.data.totalPaidPaise &&
            validPayrollCalculation(request.resource.data.currentCalculation) &&
            validPayrollEventLink(request.resource.data.lastEventId, 'slip-revised') &&
            validSalaryRevisionLink(request.resource.data, documentId)
          ) ||
          (
            request.resource.data.currentRevision == resource.data.currentRevision &&
            request.resource.data.currentRevisionId == resource.data.currentRevisionId &&
            request.resource.data.currentCalculation == resource.data.currentCalculation &&
            request.resource.data.totalPaidPaise > resource.data.totalPaidPaise &&
            request.resource.data.outstandingPaise == 0 &&
            request.resource.data.paymentState == 'paid' &&
            validPayrollEventLink(request.resource.data.lastEventId, 'payment-recorded')
          )
        );
      allow delete: if false;
    }

    match /salarySlipRevisions/{documentId} {
      allow read: if isOwner() || (isStaff() && resource.data.employeeUserId == request.auth.uid);
      allow create: if isOwner() &&
        request.resource.data.id == documentId && request.resource.data.slipId is string &&
        request.resource.data.revision is int && request.resource.data.revision >= 1 &&
        request.resource.data.employeeUserId is string && isPayrollRole(request.resource.data.employeeRole) &&
        validPayrollMonthKey(request.resource.data.payrollMonth) &&
        request.resource.data.issuer is map && request.resource.data.issuer.name is string &&
        request.resource.data.term is map && request.resource.data.calculation is map &&
        validPayrollCalculation(request.resource.data.calculation) &&
        request.resource.data.reason is string && request.resource.data.reason.size() > 0 &&
        request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/salarySlips/$(request.resource.data.slipId)).data.currentRevisionId == documentId;
      allow update, delete: if false;
    }

    match /payrollEvents/{documentId} {
      allow read: if isOwner() || (
        isStaff() && resource.data.keys().hasAny(['employeeUserId']) && resource.data.employeeUserId == request.auth.uid
      );
      allow create: if isOwner() &&
        request.resource.data.id == documentId && request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorName is string && request.resource.data.actorName.size() > 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.type in [
          'settings-updated', 'profile-updated', 'term-created', 'month-configured',
          'slip-finalized', 'slip-revised', 'payment-recorded'
        ];
      allow update, delete: if false;
    }

    match /appMetadata/nameDirectory {
      allow read, write: if isStaff();
    }

    match /appMetadata/vendorCatalog {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /appMetadata/vendorLedgerV2Config {
      allow read: if isStaff();
      allow create: if isOwner() &&
        request.resource.data.enabled == true &&
        request.resource.data.activationDate is string &&
        request.resource.data.updatedByUserId == request.auth.uid;
      allow update: if isOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'updatedAt', 'updatedByUserId']) &&
        request.resource.data.activationDate == resource.data.activationDate &&
        request.resource.data.updatedByUserId == request.auth.uid;
      allow delete: if false;
    }

    match /appMetadata/appSettings {
      allow read: if isStaff();
      allow create: if isOwner();
      allow update: if isOwner() || (
        isManagerOrOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBankBalance']) &&
        isNonNegativeNumber(request.resource.data.currentBankBalance)
      );
      allow delete: if false;
    }

    match /appMetadata/workspaceMetrics {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /appMetadata/{documentId} {
      allow read, write: if isOwner();
    }

    match /stores/{documentId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /sales/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff() && validSales(request.resource.data, documentId);
      allow update: if isStaff() &&
        validSales(request.resource.data, documentId) &&
        request.resource.data.storeId == resource.data.storeId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }

    match /purchases/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff() && isVendorLedgerV2Inactive() && validPurchaseCreate(request.resource.data, documentId);
      allow update: if isVendorLedgerV2Inactive() && (isOwner() || (isStaff() && isVendorPaymentAllocation()));
      allow delete: if isOwner();
    }

    match /vendors/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isOwner() || (isStaff() && (isOpeningBalanceAllocation() || isVendorDirectoryUpdate()));
      allow delete: if isOwner();
    }

    match /cashouts/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isOwner();
    }

    match /payments/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff() && (
        (
          request.resource.data.keys().hasAny(['entryType']) &&
          request.resource.data.entryType == 'loan-payment' &&
          isOwner()
        ) ||
        (
          isVendorLedgerV2Inactive() &&
          (
            !request.resource.data.keys().hasAny(['entryType']) ||
            request.resource.data.entryType == 'vendor-payment'
          )
        )
      );
      allow update, delete: if isOwner();
    }

    match /loans/{documentId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /dailyCashouts/{documentId} {
      allow read: if isStaff();
      allow create: if isOwner() || (
        isStaff() &&
        isCashoutWindowOpen() &&
        request.resource.data.recordedByUserId == request.auth.uid
      );
      allow update, delete: if isOwner();
    }

    match /cashoutCorrectionRequests/{documentId} {
      allow read: if isOwner() || (
        isStaff() &&
        resource.data.requestedByUserId == request.auth.uid
      );
      allow create: if isOwner() || (
        isStaff() &&
        isCashoutWindowOpen() &&
        request.resource.data.requestedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestType == 'staff-request' &&
        get(/databases/$(database)/documents/dailyCashouts/$(request.resource.data.cashoutId)).data.recordedByUserId == request.auth.uid
      );
      allow update: if isOwner() || (
        isStaff() &&
        isCashoutWindowOpen() &&
        resource.data.requestedByUserId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'withdrawn' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedAt',
          'reviewedByUserId',
          'reviewedBy',
          'reviewReason'
        ])
      );
      allow delete: if false;
    }

    match /cashTransfers/{documentId} {
      allow read: if isStaff();
      allow create: if validCashTransferCreate(request.resource.data, documentId) && (
        isManagerOrOwner() || (isBilling() && request.resource.data.fromUserId == request.auth.uid)
      );
      allow update, delete: if isOwner();
    }

    match /plannedPayments/{documentId} {
      allow read: if isStaff();
      allow create, update, delete: if isManagerOrOwner();
    }

    match /monthlyReports/{documentId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /settingsAudit/{documentId} {
      allow read: if isOwner();
      allow create: if isManagerOrOwner() &&
        request.resource.data.actor == userDoc().data.name &&
        request.resource.data.action is string &&
        request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    match /vendorsV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if (isVendorLedgerV2Enabled() || (isOwner() && isVendorLedgerV2EnabledAfter())) &&
        hasPurchasingCapability('vendor.manage') && validVendorV2(request.resource.data, documentId);
      allow update: if isVendorLedgerV2Enabled() && isOwner() && immutableV2Identity();
      allow delete: if false;
    }

    match /purchasesV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() && hasPurchasingCapability('purchase.create') && validPurchaseV2(request.resource.data, documentId);
      allow update: if false;
      allow delete: if false;
    }

    match /invoiceReservationsV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() &&
        hasPurchasingCapability('purchase.create') &&
        validInvoiceReservationV2(request.resource.data, documentId);
      allow update, delete: if false;
    }

    match /vendorSettlementsV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() && hasPurchasingCapability('settlement.create') && validSettlementV2(request.resource.data, documentId);
      allow update: if false;
      allow delete: if false;
    }

    match /vendorSettlementStatesV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() && hasPurchasingCapability('settlement.create') &&
        validSettlementStateCreate(request.resource.data, documentId);
      allow update: if isVendorLedgerV2Enabled() && validSettlementStateCorrection(request.resource.data, documentId);
      allow delete: if false;
    }

    match /vendorAccountStatesV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if (isVendorLedgerV2Enabled() || (isOwner() && isVendorLedgerV2EnabledAfter())) &&
        validVendorAccountStateCreate(request.resource.data, documentId) &&
        canCreateLedgerEntry(getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(request.resource.data.lastLedgerEntryId)).data);
      allow update: if isVendorLedgerV2Enabled() && validVendorAccountStateUpdate(request.resource.data, documentId) &&
        canCreateLedgerEntry(getAfter(/databases/$(database)/documents/vendorLedgerEntriesV2/$(request.resource.data.lastLedgerEntryId)).data);
      allow delete: if false;
    }

    match /invoiceStatesV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() && hasPurchasingCapability('purchase.create') && validInvoiceStateCreate(request.resource.data, documentId);
      allow update: if isVendorLedgerV2Enabled() && hasPurchasingCapability('settlement.create') && validInvoiceStateUpdate(request.resource.data, documentId);
      allow delete: if false;
    }

    match /vendorReturnsV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() && hasPurchasingCapability('return.create') && validReturnV2(request.resource.data, documentId);
      allow update: if isVendorLedgerV2Enabled() && canResolveVendorReturn();
      allow delete: if false;
    }

    match /chequeBooksV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if (isVendorLedgerV2Enabled() || isVendorLedgerV2EnabledAfter()) && isOwner();
      allow update: if isVendorLedgerV2Enabled() && isOwner();
      allow delete: if false;
    }

    match /chequesV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() && hasPurchasingCapability('cheque.prepare') && validChequeV2(request.resource.data, documentId);
      allow update: if isVendorLedgerV2Enabled() && canUpdateChequeStatus();
      allow delete: if false;
    }

    match /vendorLedgerEntriesV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && hasPurchasingCapability('vendorLedger.view');
      allow create: if (isVendorLedgerV2Enabled() || (isOwner() && isVendorLedgerV2EnabledAfter())) &&
        request.resource.data.id == documentId &&
        request.resource.data.vendorId is string &&
        request.resource.data.posting in ['financial', 'informational'] &&
        request.resource.data.signedAmountPaise is int &&
        request.resource.data.sourceRecordId is string &&
        request.resource.data.sourceRevision is int &&
        request.resource.data.sourceRevision >= 1 &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdByUserId == request.auth.uid &&
        canCreateLedgerEntry(request.resource.data) &&
        validOpeningLedgerEntry(request.resource.data, documentId) &&
        validPurchaseLedgerEntry(request.resource.data, documentId) &&
        validSettlementLedgerEntry(request.resource.data, documentId) &&
        validCorrectionLedgerEntry(request.resource.data, documentId) &&
        validReturnLedgerEntry(request.resource.data, documentId) &&
        validChequeLedgerEntry(request.resource.data, documentId);
      allow update, delete: if false;
    }

    match /invoiceAllocationsV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && isStaff();
      allow create: if isVendorLedgerV2Enabled() && isPositivePaise(request.resource.data.amountPaise) && (
        (hasPurchasingCapability('settlement.create') && validSettlementAllocation(request.resource.data, documentId)) ||
        (isOwner() && validCorrectionAllocation(request.resource.data, documentId))
      );
      allow update: if false;
      allow delete: if false;
    }

    match /vendorLedgerCorrectionRequestsV2/{documentId} {
      allow read: if isVendorLedgerV2Enabled() && (isOwner() || (
        isStaff() && resource.data.requestedByUserId == request.auth.uid
      ));
      allow create: if isVendorLedgerV2Enabled() && hasPurchasingCapability('settlement.correct') &&
        request.resource.data.kind == 'settlement-correction' &&
        request.resource.data.requestedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.sourceRevision == get(/databases/$(database)/documents/vendorSettlementStatesV2/$(request.resource.data.sourceRecordId)).data.revision &&
        request.resource.data.before.amountPaise == get(/databases/$(database)/documents/vendorSettlementStatesV2/$(request.resource.data.sourceRecordId)).data.amountPaise &&
        request.resource.data.before.date == get(/databases/$(database)/documents/vendorSettlementStatesV2/$(request.resource.data.sourceRecordId)).data.date &&
        request.resource.data.before.mode == get(/databases/$(database)/documents/vendorSettlementStatesV2/$(request.resource.data.sourceRecordId)).data.mode &&
        request.resource.data.before.notes == get(/databases/$(database)/documents/vendorSettlementStatesV2/$(request.resource.data.sourceRecordId)).data.notes &&
        request.resource.data.vendorId == get(/databases/$(database)/documents/vendorSettlementStatesV2/$(request.resource.data.sourceRecordId)).data.vendorId &&
        (
          (isOwner() && request.resource.data.requestType in ['staff-request', 'owner-edit']) ||
          (
            request.resource.data.requestType == 'staff-request' &&
            get(/databases/$(database)/documents/vendorSettlementsV2/$(request.resource.data.sourceRecordId)).data.createdByUserId == request.auth.uid
          )
        );
      allow update: if isVendorLedgerV2Enabled() && resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedByUserId', 'reviewedBy', 'reviewReason'
        ]) && (
          (
            isOwner() && request.resource.data.status in ['approved', 'rejected'] &&
            request.resource.data.reviewedByUserId == request.auth.uid
          ) ||
          (
            isStaff() && resource.data.requestedByUserId == request.auth.uid &&
            request.resource.data.status == 'withdrawn' &&
            request.resource.data.reviewedByUserId == request.auth.uid
          )
        );
      allow delete: if false;
    }

    // POS (Test) is deliberately isolated below this single sandbox document.
    // No rule in this block grants access to a production collection.
    match /posSandboxes/{sandboxId} {
      function handoverPath() {
        return /databases/$(database)/documents/posSandboxes/$(sandboxId)/handover/main;
      }
      function handoverEnabled() { return exists(handoverPath()); }
      function paymentAt(payments, index, method) {
        return payments.size() > index && payments[index].method == method ? payments[index].amountPaise : 0;
      }
      function paymentTotal(payments, method) {
        return paymentAt(payments, 0, method) + paymentAt(payments, 1, method) + paymentAt(payments, 2, method) + paymentAt(payments, 3, method);
      }
      function validPaymentAt(payments, index) {
        return payments.size() <= index || (payments[index].method in ['cash', 'upi', 'card'] && payments[index].amountPaise is int && payments[index].amountPaise >= 0);
      }
      function dayTotals(data, date) { return data.dailyTotals.get(date, {'upi': 0, 'card': 0}); }
      function validHandoverDate(date) {
        return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          timestamp.date(int(date.split('-')[0]), int(date.split('-')[1]), int(date.split('-')[2])) ==
          (request.time + duration.value(19800, 's')).date();
      }
      function validHandoverBill(bill, billId) {
        let after = getAfter(handoverPath()).data;
        let state = getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/cashierStates/$(request.auth.uid)).data;
        return after.initialized == true && validHandoverDate(bill.handoverDate) && bill.cashierAuthTime == request.auth.token.auth_time &&
          bill.payments.size() > 0 && bill.payments.size() <= 4 && validPaymentAt(bill.payments, 0) && validPaymentAt(bill.payments, 1) &&
          validPaymentAt(bill.payments, 2) && validPaymentAt(bill.payments, 3) &&
          paymentTotal(bill.payments, 'cash') + paymentTotal(bill.payments, 'upi') + paymentTotal(bill.payments, 'card') == bill.totalPaise &&
          after.lastOperation == 'bill' && after.lastOperationId == billId &&
          state.authTime == request.auth.token.auth_time && state.needsLogoutCheck == true && state.lastBillId == billId;
      }
      function validBillLedger(before, after) {
        let bill = getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/bills/$(after.lastOperationId)).data;
        let previous = dayTotals(before, bill.handoverDate);
        let next = dayTotals(after, bill.handoverDate);
        return !exists(/databases/$(database)/documents/posSandboxes/$(sandboxId)/bills/$(after.lastOperationId)) &&
          bill.createdByUid == request.auth.uid && bill.payments.size() <= 4 &&
          after.cashNetPaise == before.cashNetPaise + paymentTotal(bill.payments, 'cash') &&
          next.upi == previous.upi + paymentTotal(bill.payments, 'upi') &&
          next.card == previous.card + paymentTotal(bill.payments, 'card') &&
          after.dailyTotals.diff(before.dailyTotals).affectedKeys().hasOnly([bill.handoverDate]) &&
          after.diff(before).affectedKeys().hasOnly(['revision', 'cashNetPaise', 'dailyTotals', 'lastOperation', 'lastOperationId', 'updatedByUid']);
      }
      function validRefundLedger(before, after) {
        let path = /databases/$(database)/documents/posSandboxes/$(sandboxId)/approvals/$(after.lastOperationId);
        let approval = getAfter(path).data;
        let bill = get(/databases/$(database)/documents/posSandboxes/$(sandboxId)/bills/$(approval.billId)).data;
        let statePath = /databases/$(database)/documents/posSandboxes/$(sandboxId)/billStates/$(approval.billId);
        let payments = approval.type == 'void' ? (bill.createdAt >= '2026-10-03T18:30:00.000Z' ? bill.payments : []) : [{'method': approval.refundMethod, 'amountPaise': approval.refundAmountPaise}];
        let previous = dayTotals(before, approval.handoverDate);
        let next = dayTotals(after, approval.handoverDate);
        return get(path).data.status == 'pending' && approval.status == 'approved' && approval.reviewedByUid == request.auth.uid &&
          validHandoverDate(approval.handoverDate) && approval.type in ['void', 'return'] &&
          get(statePath).data.revision == approval.sourceBillRevision && getAfter(statePath).data.revision == approval.sourceBillRevision + 1 &&
          getAfter(statePath).data.state == (approval.type == 'void' ? 'voided' : 'partially-returned') &&
          after.cashNetPaise == before.cashNetPaise - paymentTotal(payments, 'cash') &&
          next.upi == previous.upi - paymentTotal(payments, 'upi') && next.card == previous.card - paymentTotal(payments, 'card') &&
          after.dailyTotals.diff(before.dailyTotals).affectedKeys().hasOnly([approval.handoverDate]) &&
          after.diff(before).affectedKeys().hasOnly(['revision', 'cashNetPaise', 'dailyTotals', 'lastOperation', 'lastOperationId', 'updatedByUid']);
      }
      function noteCount(notes, key) { return notes.get(key, 0); }
      function validCount(value) { return value is int && value >= 0 && value <= 1000000; }
      function validDenominations(notes, coins, cash) {
        return notes is map && notes.keys().hasOnly(['500', '200', '100', '50', '20', '10', '5', '2', '1']) &&
          validCount(noteCount(notes, '500')) && validCount(noteCount(notes, '200')) && validCount(noteCount(notes, '100')) &&
          validCount(noteCount(notes, '50')) && validCount(noteCount(notes, '20')) && validCount(noteCount(notes, '10')) &&
          validCount(noteCount(notes, '5')) && validCount(noteCount(notes, '2')) && validCount(noteCount(notes, '1')) &&
          coins is int && coins >= 0 && cash == coins + 100 * (
            500 * noteCount(notes, '500') + 200 * noteCount(notes, '200') + 100 * noteCount(notes, '100') +
            50 * noteCount(notes, '50') + 20 * noteCount(notes, '20') + 10 * noteCount(notes, '10') +
            5 * noteCount(notes, '5') + 2 * noteCount(notes, '2') + noteCount(notes, '1'));
      }
      function expectedCash(before) {
        return before.get('checkpoint', {}).get('cashActualPaise', 0) + before.cashNetPaise - before.get('checkpoint', {}).get('cashNetPaise', 0);
      }
      function expectedTerminal(before, date, method) {
        let checkpoint = before.get('checkpoint', {});
        let totals = dayTotals(before, date);
        return checkpoint.get('date', '') == date ?
          (method == 'upi' ? checkpoint.upiActualPaise + totals.upi - checkpoint.upiNetPaise : checkpoint.cardActualPaise + totals.card - checkpoint.cardNetPaise) : totals[method];
      }
      function validReconciliation(record, id) {
        let before = get(handoverPath()).data;
        let after = getAfter(handoverPath()).data;
        let state = getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/cashierStates/$(request.auth.uid)).data;
        return before.initialized == true && record.uid == request.auth.uid && record.authTime == request.auth.token.auth_time &&
          record.keys().hasOnly(['id', 'uid', 'name', 'authTime', 'kind', 'date', 'denominations', 'coinPaise', 'actual', 'expected', 'delta', 'hasDiscrepancy', 'createdAt', 'note', 'reviewStatus']) &&
          record.get('id', id) == id && record.get('note', '') is string && record.get('note', '').size() <= 1000 &&
          record.kind in ['login', 'logout'] && validHandoverDate(record.date) && record.createdAt is string && record.name is string &&
          validDenominations(record.denominations, record.coinPaise, record.actual.cash) &&
          record.actual.upi is int && record.actual.upi >= 0 && record.actual.card is int && record.actual.card >= 0 &&
          record.expected.cash == expectedCash(before) && record.expected.upi == expectedTerminal(before, record.date, 'upi') &&
          record.expected.card == expectedTerminal(before, record.date, 'card') &&
          record.delta.cash == record.actual.cash - record.expected.cash &&
          record.delta.upi == record.actual.upi - record.expected.upi && record.delta.card == record.actual.card - record.expected.card &&
          record.hasDiscrepancy == (record.delta.cash != 0 || record.delta.upi != 0 || record.delta.card != 0) &&
          record.reviewStatus == (record.hasDiscrepancy ? 'pending' : 'matched') &&
          after.lastOperation == 'reconciliation' && after.lastOperationId == id &&
          state.authTime == request.auth.token.auth_time && state.lastReconciliationId == id && state.needsLogoutCheck == false;
      }
      function validCheckpoint(before, after) {
        let record = getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/reconciliations/$(after.lastOperationId)).data;
        let checkpoint = after.checkpoint;
        let totals = dayTotals(before, record.date);
        return !exists(/databases/$(database)/documents/posSandboxes/$(sandboxId)/reconciliations/$(after.lastOperationId)) &&
          record.uid == request.auth.uid &&
          after.diff(before).affectedKeys().hasOnly(['revision', 'checkpoint', 'lastOperation', 'lastOperationId', 'updatedByUid']) &&
          checkpoint.keys().hasOnly(['cashActualPaise', 'cashNetPaise', 'date', 'upiActualPaise', 'cardActualPaise', 'upiNetPaise', 'cardNetPaise', 'reconciliationId']) &&
          checkpoint.cashActualPaise == record.actual.cash && checkpoint.cashNetPaise == before.cashNetPaise &&
          checkpoint.date == record.date && checkpoint.upiActualPaise == record.actual.upi && checkpoint.cardActualPaise == record.actual.card &&
          checkpoint.upiNetPaise == totals.upi && checkpoint.cardNetPaise == totals.card && checkpoint.reconciliationId == after.lastOperationId;
      }
      function validCashierState(uid) {
        let data = request.resource.data;
        let handover = getAfter(handoverPath()).data;
        return uid == request.auth.uid && data.uid == uid && data.authTime == request.auth.token.auth_time && data.updatedAt is string &&
          data.keys().hasOnly(['uid', 'authTime', 'needsLogoutCheck', 'lastBillId', 'lastReconciliationId', 'updatedAt', 'closed']) &&
          ((handover.lastOperation == 'bill' && !exists(/databases/$(database)/documents/posSandboxes/$(sandboxId)/bills/$(handover.lastOperationId)) && data.needsLogoutCheck == true && data.lastBillId == handover.lastOperationId &&
            data.get('closed', false) == false &&
            (!exists(/databases/$(database)/documents/posSandboxes/$(sandboxId)/cashierStates/$(uid)) || (resource.data.authTime == data.authTime && resource.data.get('closed', false) == false)) &&
            data.lastReconciliationId == (exists(/databases/$(database)/documents/posSandboxes/$(sandboxId)/cashierStates/$(uid)) ? resource.data.lastReconciliationId : '')) ||
           (handover.lastOperation == 'reconciliation' && !exists(/databases/$(database)/documents/posSandboxes/$(sandboxId)/reconciliations/$(handover.lastOperationId)) &&
            getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/reconciliations/$(handover.lastOperationId)).data.uid == uid &&
            getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/reconciliations/$(handover.lastOperationId)).data.authTime == data.authTime &&
            data.needsLogoutCheck == false && data.lastReconciliationId == handover.lastOperationId &&
            data.get('closed', false) == (getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/reconciliations/$(handover.lastOperationId)).data.kind == 'logout')));
      }
      match /handover/{handoverId} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && handoverId == 'main' && isOwner() &&
          request.resource.data.initialized == false && request.resource.data.revision == 0 &&
          request.resource.data.cashNetPaise is int && request.resource.data.dailyTotals is map &&
          request.resource.data.lastOperation == 'initialize' && request.resource.data.updatedByUid == request.auth.uid &&
          !('checkpoint' in request.resource.data);
        allow update: if sandboxId == 'test' && handoverId == 'main' && isStaff() &&
          request.resource.data.initialized == true && request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.updatedByUid == request.auth.uid &&
          ((isOwner() && resource.data.initialized == false && request.resource.data.lastOperation == 'initialize' && !('checkpoint' in request.resource.data)) ||
           (resource.data.initialized == true && request.resource.data.lastOperation == 'bill' && validBillLedger(resource.data, request.resource.data)) ||
           (request.resource.data.lastOperation == 'reconciliation' && validCheckpoint(resource.data, request.resource.data)) ||
           (isOwner() && resource.data.initialized == true && request.resource.data.lastOperation == 'refund' && validRefundLedger(resource.data, request.resource.data)));
        allow delete: if false;
      }
      match /cashierStates/{uid} {
        allow read: if sandboxId == 'test' && (isOwner() || (isStaff() && uid == request.auth.uid));
        allow create: if sandboxId == 'test' && isStaff() && (validCashierState(uid) ||
          (isOwner() && get(handoverPath()).data.initialized == false && request.resource.data.uid == uid &&
           request.resource.data.authTime == 0 && request.resource.data.needsLogoutCheck == true && request.resource.data.lastReconciliationId == '' &&
           get(/databases/$(database)/documents/posSandboxes/$(sandboxId)/bills/$(request.resource.data.lastBillId)).data.createdByUid == uid));
        allow update: if sandboxId == 'test' && isStaff() && validCashierState(uid);
        allow delete: if false;
      }
      match /reconciliations/{id} {
        allow read: if sandboxId == 'test' && (isOwner() || (isStaff() && resource.data.uid == request.auth.uid));
        allow create: if sandboxId == 'test' && isStaff() && validReconciliation(request.resource.data, id);
        allow update: if sandboxId == 'test' && isOwner() && resource.data.reviewStatus == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus', 'reviewedByUid', 'reviewedAt']) &&
          request.resource.data.reviewStatus == 'reviewed' && request.resource.data.reviewedByUid == request.auth.uid && request.resource.data.reviewedAt is string;
        allow delete: if false;
      }
      allow read: if sandboxId == 'test' && isStaff();
      allow create, update, delete: if sandboxId == 'test' && isOwner();

      match /products/{productId} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && isOwner() &&
          request.resource.data.barcode is string &&
          request.resource.data.currentQuantity is int &&
          request.resource.data.sellingPricePaise is int && request.resource.data.sellingPricePaise >= 0 &&
          request.resource.data.revision == 1 &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update: if sandboxId == 'test' && (
          (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['searchTokens']) &&
            request.resource.data.searchTokens is list && request.resource.data.searchTokens.size() <= 500) ||
          (isStaff() &&
            request.resource.data.revision == resource.data.revision + 1 &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.createdByUid == resource.data.createdByUid &&
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'barcode', 'name', 'searchName', 'searchTokens', 'category', 'brand', 'vendor', 'sellingPricePaise',
                'active', 'revision', 'updatedAt', 'updatedByUid', 'updatedByName'
              ]) ||
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'currentQuantity', 'revision', 'lastMovementId', 'updatedAt', 'updatedByUid', 'updatedByName'
                ]) &&
                request.resource.data.currentQuantity is int &&
                request.resource.data.updatedByUid == request.auth.uid &&
                getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/stockMovements/$(request.resource.data.lastMovementId)).data.productId == productId &&
                getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/stockMovements/$(request.resource.data.lastMovementId)).data.actorUid == request.auth.uid &&
                getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/stockMovements/$(request.resource.data.lastMovementId)).data.productRevisionBefore == resource.data.revision &&
                getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/stockMovements/$(request.resource.data.lastMovementId)).data.productRevisionAfter == request.resource.data.revision &&
                getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/stockMovements/$(request.resource.data.lastMovementId)).data.beforeQuantity == resource.data.currentQuantity &&
                getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/stockMovements/$(request.resource.data.lastMovementId)).data.afterQuantity == request.resource.data.currentQuantity
              )
            )));
        allow delete: if sandboxId == 'test' && isOwner();
      }

      match /productCosts/{productId} {
        allow read: if sandboxId == 'test' && isManagerOrOwner();
        allow create, update: if sandboxId == 'test' && isManagerOrOwner() &&
          request.resource.data.productId == productId &&
          request.resource.data.updatedByUid == request.auth.uid &&
          (request.resource.data.costPaise == null || (request.resource.data.costPaise is int && request.resource.data.costPaise >= 0));
        allow delete: if sandboxId == 'test' && isOwner();
      }

      match /stockMovements/{movementId} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && isStaff() &&
          request.resource.data.id == movementId &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.quantityDelta is int &&
          request.resource.data.beforeQuantity is int &&
          request.resource.data.afterQuantity is int &&
          request.resource.data.afterQuantity == request.resource.data.beforeQuantity + request.resource.data.quantityDelta &&
          request.resource.data.productRevisionAfter == request.resource.data.productRevisionBefore + 1;
        allow update: if false;
        allow delete: if sandboxId == 'test' && isOwner();
      }

      match /bills/{billId} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && isStaff() &&
          request.resource.data.id == billId &&
          request.resource.data.testOnly == true &&
          request.resource.data.status == 'finalized' &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.subtotalPaise is int && request.resource.data.subtotalPaise >= 0 &&
          request.resource.data.totalPaise is int && request.resource.data.totalPaise >= 0 &&
          request.resource.data.lines is list && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 200 &&
          request.resource.data.payments is list &&
          (!handoverEnabled() || validHandoverBill(request.resource.data, billId)) &&
          getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/sequences/$(request.resource.data.financialYear)).data.lastNumber == request.resource.data.sequenceNumber &&
          getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/billStates/$(billId)).data.billId == billId &&
          getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/billStates/$(billId)).data.revision == 1;
        allow update: if false;
        allow delete: if sandboxId == 'test' && isOwner() && !handoverEnabled();
      }

      match /billStates/{billId} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && isStaff() && request.resource.data.billId == billId && request.resource.data.state == 'active' && request.resource.data.revision == 1 && request.resource.data.updatedByUid == request.auth.uid;
        allow update: if sandboxId == 'test' && isOwner() && request.resource.data.billId == resource.data.billId && request.resource.data.revision == resource.data.revision + 1 &&
          (!handoverEnabled() || (get(handoverPath()).data.initialized == true &&
            getAfter(handoverPath()).data.revision == get(handoverPath()).data.revision + 1 &&
            getAfter(handoverPath()).data.lastOperation == 'refund' && getAfter(handoverPath()).data.updatedByUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/posSandboxes/$(sandboxId)/approvals/$(getAfter(handoverPath()).data.lastOperationId)).data.billId == billId));
        allow delete: if sandboxId == 'test' && isOwner() && !handoverEnabled();
      }

      match /heldCarts/{cartId} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && isStaff() && request.resource.data.createdByUid == request.auth.uid && request.resource.data.updatedByUid == request.auth.uid && request.resource.data.revision == 1;
        allow update: if sandboxId == 'test' && isStaff() && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdByUid == resource.data.createdByUid && request.resource.data.updatedByUid == request.auth.uid && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if sandboxId == 'test' && isStaff();
      }

      match /approvals/{approvalId} {
        allow read: if sandboxId == 'test' && (isOwner() || (isStaff() && resource.data.requestedByUid == request.auth.uid));
        allow create: if sandboxId == 'test' && isStaff() &&
          request.resource.data.requestedByUid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.type in ['void', 'return'] &&
          request.resource.data.reason is string && request.resource.data.reason.size() > 0;
        allow update: if sandboxId == 'test' && isOwner() && resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handoverDate', 'reviewedAt', 'reviewedByUid', 'reviewedByName', 'reviewReason']) &&
          request.resource.data.status in ['approved', 'rejected', 'stale'] &&
          request.resource.data.reviewedByUid == request.auth.uid &&
          (request.resource.data.status != 'approved' || !handoverEnabled() ||
            (getAfter(handoverPath()).data.lastOperation == 'refund' && getAfter(handoverPath()).data.lastOperationId == approvalId &&
             getAfter(handoverPath()).data.revision == get(handoverPath()).data.revision + 1));
        allow delete: if sandboxId == 'test' && isOwner();
      }

      match /events/{eventId} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && isStaff() && request.resource.data.actorUid == request.auth.uid && request.resource.data.type is string;
        allow update: if false;
        allow delete: if sandboxId == 'test' && isOwner() && !handoverEnabled();
      }

      match /sequences/{financialYear} {
        allow read: if sandboxId == 'test' && isStaff();
        allow create: if sandboxId == 'test' && isStaff() && request.resource.data.financialYear == financialYear && request.resource.data.lastNumber == 1 && request.resource.data.updatedByUid == request.auth.uid;
        allow update: if sandboxId == 'test' && isStaff() && request.resource.data.financialYear == resource.data.financialYear && request.resource.data.lastNumber == resource.data.lastNumber + 1 && request.resource.data.updatedByUid == request.auth.uid;
        allow delete: if sandboxId == 'test' && isOwner();
      }

      match /configuration/{configId} {
        allow read: if sandboxId == 'test' && ((configId == 'checkout' && isStaff()) || isOwner());
        allow create, update, delete: if sandboxId == 'test' && isOwner();
      }

      match /importRuns/{runId} {
        allow read, create, update, delete: if sandboxId == 'test' && isOwner();
      }

      match /resetRuns/{runId} {
        allow read, create, update, delete: if sandboxId == 'test' && isOwner();
      }

      match /{unknownCollection}/{documentId} {
        allow read, write: if false;
      }
    }
  }
}
