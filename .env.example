VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional loopback-only automatic sign-in. Leave disabled for normal use.
# VITE_* values are client-visible: never put real passwords in a release build.
VITE_LOCAL_AUTH_BYPASS=false
VITE_LOCAL_AUTH_EMAIL=
VITE_LOCAL_AUTH_PASSWORD=
