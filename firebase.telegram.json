{
  "functions": {
    "source": "output/telegram-functions",
    "codebase": "telegram",
    "runtime": "nodejs22",
    "predeploy": [
      "node functions/scripts/prepareTelegramFunctions.js",
      "npm --prefix output/telegram-functions ci --ignore-scripts"
